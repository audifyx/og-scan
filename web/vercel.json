{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "npm run build && npm --prefix ogdex install --no-audit --no-fund && npm --prefix ogdex run build",
  "rewrites": [
    {
      "source": "/ai-fn/(.*)",
      "destination": "https://ffjipnkhcebjvttliptb.supabase.co/functions/v1/$1"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/api/mcp?path=mcp/$1"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp?path=mcp"
    },
    {
      "source": "/api/mcp/(.*)",
      "destination": "/api/mcp?path=mcp/$1"
    },
    {
      "source": "/api/x/mcp/(.*)",
      "destination": "/api/x-mcp?path=mcp/$1"
    },
    {
      "source": "/api/x/mcp",
      "destination": "/api/x-mcp?path=mcp"
    },
    {
      "source": "/api/x/agent/(.*)",
      "destination": "/api/x-mcp?path=agent/$1"
    },
    {
      "source": "/api/x/agent",
      "destination": "/api/x-mcp?path=agent"
    },
    {
      "source": "/api/orbitx-world/(.*)",
      "destination": "/api/orbitx-world?path=$1"
    },
    {
      "source": "/api/orbitx-agent/(.*)",
      "destination": "/api/orbitx-hub?path=agent/$1"
    },
    {
      "source": "/api/orbitx-agent",
      "destination": "/api/orbitx-hub?path=agent"
    },
    {
      "source": "/api/orbitx-mcp/(.*)",
      "destination": "/api/orbitx-hub?path=mcp/$1"
    },
    {
      "source": "/api/orbitx-mcp",
      "destination": "/api/orbitx-hub?path=mcp"
    },
    {
      "source": "/api/orbitx/(.*)",
      "destination": "/api/orbitx-hub?path=$1"
    },
    {
      "source": "/api/orbitx",
      "destination": "/api/orbitx-hub"
    },
    {
      "source": "/api/ogdex/(.*)",
      "destination": "/api/ogdex?path=$1"
    },
    {
      "source": "/api/kol/(.*)",
      "destination": "/api/kol?action=$1"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/orbitx-hub?path=mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/orbitx-hub?path=mcp/.well-known/oauth-authorization-server"
    },
    {
      "source": "/mcp/.well-known/oauth-protected-resource",
      "destination": "/api/orbitx-hub?path=mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/mcp/.well-known/oauth-authorization-server",
      "destination": "/api/orbitx-hub?path=mcp/.well-known/oauth-authorization-server"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/share/:mint",
      "destination": "/api/share?mint=:mint"
    },
    {
      "source": "/sharew/:address",
      "destination": "/api/share-wallet?address=:address"
    },
    {
      "source": "/ORBITX_DEX",
      "destination": "/ORBITX_DEX/index.html"
    },
    {
      "source": "/ORBITX_DEX/(.*)",
      "destination": "/ORBITX_DEX/index.html"
    },
    {
      "source": "/predictions/api/:path*",
      "destination": "https://orbitx-prediction.fun/api/:path*"
    },
    {
      "source": "/predictions/_next/:path*",
      "destination": "https://orbitx-prediction.fun/_next/:path*"
    },
    {
      "source": "/predictions",
      "destination": "https://orbitx-prediction.fun/"
    },
    {
      "source": "/predictions/:path*",
      "destination": "https://orbitx-prediction.fun/:path*"
    },
    {
      "source": "/",
      "destination": "/app.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/ORBITX_DEX/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ORBITX_DEX",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/ORBITX_DEX/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index-app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    },
    {
      "source": "/u/:username/widget",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 120
    },
    "api/orbitx-hub.js": {
      "maxDuration": 120
    },
    "api/ogdex.js": {
      "maxDuration": 60
    },
    "api/**/*.js": {
      "maxDuration": 30
    },
    "api/kol.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/kol/launch-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/ogdex/alerts-run",
      "schedule": "* * * * *"
    },
    {
      "path": "/predictions/api/cron/resolve",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/x-mcp?path=agent/cron",
      "schedule": "* * * * *"
    }
  ]
}
